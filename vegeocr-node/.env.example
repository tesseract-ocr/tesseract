# --- server ---
PORT=4000
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info
LOG_PRETTY=false
CORS_ORIGINS=http://localhost:3000        # comma-separated allowlist; never '*' in production
TRUST_PROXY=                              # set to 1 when behind Nginx/Caddy so rate limits see the real client IP
METRICS_TOKEN=                            # if set, GET /metrics needs "Authorization: Bearer <token>"
PUBLIC_DIR=public

# --- redis (empty = in-memory cache + queue + rate-limit store; fine for dev, NOT for production) ---
REDIS_URL=redis://localhost:6379/0

# --- OCR engine ---
TESSERACT_BIN=tesseract
TESSDATA_PREFIX=                          # directory containing *.traineddata
OCR_DEFAULT_LANG=eng
OCR_ALLOWED_LANGS=eng,jpn,jpn_vert,chi_sim,chi_tra
OCR_POOL_SIZE=                            # worker threads; default = CPU cores - 1
OCR_TIMEOUT_MS=120000
OCR_SYNC_MAX_KB=2048                      # in mode=auto, larger images go through the queue
OCR_MAX_DIMENSION=6000
OCR_TARGET_DPI=300

# --- uploads ---
MAX_UPLOAD_MB=20
MAX_PDF_PAGES=50
MAX_DECOMPRESSED_MB=64                    # cap for Content-Encoding'd request bodies (decompression-bomb guard)
UPLOAD_DIR=

# --- compression ---
COMPRESS_THRESHOLD=1024
ZSTD_LEVEL=3
BROTLI_LEVEL=5
GZIP_LEVEL=6
ZSTD_IMPL=auto                            # auto | native (node:zlib) | skhaz (@skhaz/zstd)

# --- cache / queue ---
CACHE_TTL_SECONDS=86400
CACHE_LRU_MAX_MB=256
QUEUE_CONCURRENCY=
QUEUE_ATTEMPTS=2
JOB_TTL_SECONDS=3600

# --- abuse protection / timeouts ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=300
RATE_LIMIT_OCR_MAX=30
REQUEST_TIMEOUT_MS=130000
KEEP_ALIVE_TIMEOUT_MS=65000               # > proxy idle timeout
HEADERS_TIMEOUT_MS=66000                  # > KEEP_ALIVE_TIMEOUT_MS
SHUTDOWN_TIMEOUT_MS=30000
