{
  "name": "vegeocr-node",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "High-throughput OCR API: dynamic compression, caching, worker pool, job queue, SSE",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env src/server.js",
    "dev": "node --watch --env-file-if-exists=.env src/server.js | pino-pretty",
    "build:public": "node scripts/build-public.js",
    "precompress": "node scripts/precompress.js",
    "test": "node --env-file-if-exists=.env --test --test-concurrency=1 \"test/*.test.js\"",
    "bench": "node bench/benchmark.js",
    "bench:sample": "node bench/make-sample.js"
  },
  "dependencies": {
    "accepts": "^2.0.0",
    "bullmq": "^6.4.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "file-type": "^22.2.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "lru-cache": "^11.5.3",
    "mime-types": "^3.0.2",
    "multer": "^2.5.0",
    "mupdf": "^1.28.1",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "piscina": "^5.3.2",
    "prom-client": "^15.1.3",
    "rate-limit-redis": "^6.0.1",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "pino-pretty": "^13.2.0"
  },
  "optionalDependencies": {
    "@skhaz/zstd": "^1.0.21"
  }
}
