{
  "auth": {
    "header": "X-API-Key",
    "note": "Create keys under API keys. The secret is shown once; store it somewhere safe. Pick the fewest scopes the integration needs."
  },
  "errors": [
    {
      "status": 401,
      "code": "missing_api_key",
      "meaning": "No X-API-Key header"
    },
    {
      "status": 401,
      "code": "invalid_api_key",
      "meaning": "The key is not recognised"
    },
    {
      "status": 401,
      "code": "disabled_api_key",
      "meaning": "The key is switched off (enable it in API keys)"
    },
    {
      "status": 401,
      "code": "expired_api_key",
      "meaning": "The key passed its expiration date (rotate it or create a new one)"
    },
    {
      "status": 401,
      "code": "revoked_api_key",
      "meaning": "An administrator revoked the key"
    },
    {
      "status": 403,
      "code": "insufficient_scope",
      "meaning": "The key is valid but lacks the scope this endpoint needs (see X-Required-Scope)"
    },
    {
      "status": 403,
      "code": "suspended",
      "meaning": "The key's owner is suspended"
    },
    {
      "status": 404,
      "code": "module_not_found / lesson_not_found / quiz_not_found / not_found",
      "meaning": "No such resource"
    },
    {
      "status": 422,
      "code": "invalid_answers / invalid_lang / validation errors",
      "meaning": "The request body or parameters are invalid"
    },
    {
      "status": 429,
      "code": "rate_limited / quota_exceeded",
      "meaning": "Wait for Retry-After; quota resets monthly"
    }
  ],
  "errorExample": {
    "error": {
      "code": "insufficient_scope",
      "message": "This API key lacks the required scope: learning:write"
    }
  },
  "endpoints": [
    {
      "group": "OCR",
      "method": "POST",
      "path": "/api/v1/ocr",
      "scope": "write",
      "summary": "Extract text from an image or PDF",
      "description": "Small files answer immediately (200). Large PDFs or async=true return 202: poll GET /api/v1/jobs/{id}.",
      "curl": "curl -X POST $API/api/v1/ocr \\\n  -H \"X-API-Key: YOUR_KEY\" \\\n  -F \"file=@invoice.png\" -F \"lang=jpn+eng\"",
      "params": [
        {
          "name": "file",
          "in": "form",
          "desc": "PNG, JPEG, TIFF, BMP, WEBP or PDF, up to 20 MB"
        },
        {
          "name": "lang",
          "in": "form",
          "desc": "jpn, jpn_vert, chi_sim, chi_tra, eng, joined with +. Default jpn+eng"
        },
        {
          "name": "async",
          "in": "form",
          "desc": "true to queue the job"
        }
      ],
