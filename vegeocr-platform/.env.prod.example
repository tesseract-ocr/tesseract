# Copy to .env on the server and replace EVERY value. Never commit the real file.
POSTGRES_PASSWORD=generate-a-long-random-string
JWT_SECRET=generate-64-hex-chars          # openssl rand -hex 32
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=a-strong-password          # NOT password123: this server is on the public internet
# How browsers reach the site (no trailing slash); used for CORS.
PUBLIC_WEB_URL=http://YOUR_IP_OR_DOMAIN
# Leave EMPTY: the API is served from the same address under /api, so the web build works from any address (IP, domain, tunnel).
PUBLIC_API_URL=
# ":80" = plain HTTP. For a FREE Let's Encrypt certificate put a hostname here instead (DNS must point at the server; ports 80 AND 443 open):
#   your own domain:                     SITE_ADDRESS=ocr.example.com
#   no domain (free public DNS service): SITE_ADDRESS=203-0-113-7.sslip.io   (use YOUR server's IP)
# and make PUBLIC_WEB_URL=https://<that same name>. LEGACY_HOST (optional) = the bare IP, redirected to HTTPS.
SITE_ADDRESS=:80
#LEGACY_HOST=203.0.113.7
